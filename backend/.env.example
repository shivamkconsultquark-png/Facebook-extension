# ---- MySQL (same variable names as the Twitter backend's daily_twitter_sync.py)
DB_USER=fbshield
DB_PASS=change-me
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fb_scam_shield
# Alternatively (used only when DB_USER/DB_NAME are not set):
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/dbname

# ---- LLM scoring (Gemini). Leave GEMINI_API_KEY empty to run rules-only.
GEMINI_API_KEY=
# Fast model; others in GEMINI_FALLBACK_MODELS are tried if it is overloaded or unavailable.
GEMINI_MODEL=gemini-flash-lite-latest
LLM_TIMEOUT_MS=10000
# Posts scored in parallel per scrape
LLM_WORKERS=4
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-latest

# ---- Optional threat intel: Google Safe Browsing v4 Lookup API key
SAFE_BROWSING_API_KEY=

# ---- Privacy / retention
# Store a truncated excerpt of analysed post text for the dashboard timeline (true/false)
STORE_POST_TEXT=true
POST_TEXT_MAX_CHARS=1000
# Analyses and the score cache are deleted after this many days
RETENTION_DAYS=30
# User-submitted feedback (incl. the excerpt they reported) is kept this long
FEEDBACK_RETENTION_DAYS=180
# Security audit log (logins, failed logins, scraper start/stop) is kept this long
AUDIT_RETENTION_DAYS=365

# ---- Abuse controls
MAX_POSTS_PER_REQUEST=20
MAX_TEXT_CHARS=5000
RATE_LIMIT_POSTS_PER_MINUTE=600
ALLOW_REGISTRATION=true
TOKEN_TTL_DAYS=30

# ---- CORS: comma-separated. Add your dashboard origin and chrome-extension://<extension-id>
CORS_ORIGINS=http://localhost:5173,https://finance.opcozero.com

# ---- Tests only: a throwaway database the integration tests may create tables in
# TEST_DATABASE_URL=mysql+pymysql://fbshield:change-me@localhost:3306/fb_scam_shield_test

# ---- Facebook browser scraper (server-side, like the Twitter auto-scraper)
# Fernet key that encrypts stored Facebook sessions. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, one is generated into backend/.session_key on first use.
SESSION_ENCRYPTION_KEY=
# true = scrape invisibly; false = show the Chrome window while scraping
SCRAPER_HEADLESS=true
# Installed browser to drive: chrome, msedge, or empty for Playwright's own Chromium
SCRAPER_BROWSER_CHANNEL=chrome
SCRAPER_SCROLLS=25
SCRAPER_MAX_POSTS=60
# Reels checked from the Reels tab each cycle, in addition to reels/videos in the feed (0 = off).
SCRAPER_REELS=10
# Multi-photo posts ("+N"): albums opened per cycle to store every photo, and photos kept per album.
SCRAPER_MAX_ALBUMS=5
SCRAPER_ALBUM_MAX=30
SCRAPER_DEFAULT_INTERVAL=300
SCRAPER_MAX_BROWSERS=2
# "Log in to Facebook" opens a visible Chrome window on the machine running the backend
SCRAPER_ALLOW_LOGIN_WINDOW=true
SCRAPER_LOGIN_TIMEOUT=300
# Restart scrapers that were running when the backend stopped. Set false on any second or test instance
# that shares this database, or it would scrape the same accounts as the main backend.
SCRAPER_RESUME=true

# ---- Logs: rotated files in backend/<LOG_DIR> (10 MB x 10). Empty = console only.
LOG_DIR=logs
LOG_LEVEL=INFO

# ---- Operations (ops/supervisor.py, ops/backup.py, ops/deploy.py)
# Port the supervisor runs the backend on, and that deploy.py health-checks
BACKEND_PORT=8001
# Where backups go (default: <project>/backups). Prefer a different disk or a synced folder.
# BACKUP_DIR=D:bshield-backups
# Automatic backup interval in hours (0 = off) and how many backups to keep
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=30
# MySQL bin folder, only if mysqldump/mysql are not on PATH or in the default install folder
# MYSQL_BIN=C:\Program Files\MySQL\MySQL Server 8.0in
